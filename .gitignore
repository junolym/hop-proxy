# 二进制文件
bin/
# 根目录误生成的二进制（go build 不带 -o 时会留在根目录）
/agent
/server
/client
*.exe

# 数据文件
data/
*.db

# 环境变量
.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# 前端
web/node_modules/
web/dist/

# OS
.DS_Store
Thumbs.db
*.tsbuildinfo

# ── GSD baseline (auto-generated) ──
.gsd
.gsd-id
.bg-shell/
*~
*.code-workspace
.env.*
!.env.example
node_modules/
.next/
dist/
# cmd/server/web/dist 是嵌入到 server 二进制的前端产物，需 tracked（不能用通用 dist/ 忽略）
!cmd/server/web/dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/

# ── Understand-Anything (knowledge graph) ──
# 提交 knowledge-graph.json / meta.json / fingerprints.json / config.json
# / .understandignore / intermediate/scan-result.json（增量更新与 dashboard 依赖）
# 仅忽略运行时垃圾与临时目录
.ua/.trash-*/
.ua/tmp/
